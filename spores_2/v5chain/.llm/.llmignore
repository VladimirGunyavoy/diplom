# .llmignore
# Файлы/директории, которые НЕ нужно включать в контекст агента
# Last updated: 2026-03-19

# === История с гигантскими логами ===
# Если в будущем history/changelog.md станет огромным (>1000 строк),
# можно будет переместить старые записи в history/archive/

# === Большие данные ===
# Если появятся симуляции, датасеты, кэши

# === Билды и временные файлы ===
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/

# === IDE ===
.vscode/
.idea/
*.swp
*.swo

# === OS ===
.DS_Store
Thumbs.db

# === Git ===
.git/
.gitignore

# === Потенциально чувствительное ===
# (пока нет, но на будущее)
secrets/
.env
*.key
credentials.json

# === Визуальные ресурсы (большие) ===
# Если появятся скриншоты, рендеры, видео
# screenshots/
# renders/

# === Архивы ===
# Старые версии, если будем архивировать
# archive/
# deprecated/
